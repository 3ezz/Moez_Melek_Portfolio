# Used when the site is served from Cloudflare (GitHub Pages ignores this file
# and applies its own 10-minute cache).

# HTML: always revalidate so content updates show up immediately
/*.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

# CSS / JS: short cache; bump the ?v= number in the HTML when you change them
/*.css
  Cache-Control: public, max-age=3600

/*.js
  Cache-Control: public, max-age=3600

# Images, videos, icons, CVs: cache for 30 days
/assets/*
  Cache-Control: public, max-age=2592000
