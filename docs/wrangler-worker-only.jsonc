{
  "name": "moez-melek-portfolio",
  "main": "src/index.js",
  "compatibility_date": "2026-02-17",
  // Sites allowed to send visit events (comma-separated)
  "vars": { "ALLOWED_ORIGINS": "https://3ezz.github.io" },
  // Lets the worker import the dashboard page (docs/analytics-dashboard.html) as text
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio_analytics",
      "database_id": "d0f37b6f-cfbf-4c5f-ab3f-7b366761ea08"
    }
  ]
}
